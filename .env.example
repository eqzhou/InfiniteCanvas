# Host port published by Docker Compose.
OPENBOARD_PORT=8080

# Keep loopback for personal use. Expose only behind an authenticated TLS proxy.
OPENBOARD_BIND=127.0.0.1

# Browser origins allowed to call the Go API directly. Keep this list explicit.
OPENBOARD_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Required bearer token. The bundled reverse proxy injects it into API requests,
# so it is not exposed to browser JavaScript. Generate a long random value and
# keep the .env file out of version control.
OPENBOARD_TOKEN=

# Required local infrastructure credentials. Use URL-safe hexadecimal values,
# for example `openssl rand -hex 32`; services stay on the private Compose network.
OPENBOARD_POSTGRES_PASSWORD=
OPENBOARD_REDIS_PASSWORD=

# 32-byte AES key encoded as 64 hexadecimal characters. Changing it makes saved
# provider credentials unreadable; back it up with the database.
OPENBOARD_MASTER_KEY=
