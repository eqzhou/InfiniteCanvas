# Host port published by Docker Compose.
OPENBOARD_PORT=8080

# Keep loopback for personal use. Expose only behind an authenticated TLS proxy.
OPENBOARD_BIND=127.0.0.1

# Browser origins allowed to call the Go API directly. Keep this list explicit.
OPENBOARD_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Account enforcement: `optional` (default) permits zero-user bootstrap, then
# requires a session for protected data-plane routes as soon as the first user
# exists. `required` enforces that session boundary from the start. `off`
# disables accounts; sensitive/process operations still require the bearer
# token below. A process token never impersonates a user in account modes.
OPENBOARD_AUTH_MODE=optional

# Host Codex/Claude execution is available automatically only when auth is off.
# Account-backed deployments must opt in explicitly and should do so only when
# every account is trusted with the server OS user's workspace permissions.
OPENBOARD_AGENT_ACCOUNT_EXECUTION=false

# Canonical allowlist for Codex/Claude working directories. Separate multiple
# roots with the platform path-list separator (`:` on macOS/Linux). Defaults to
# the server process working directory when omitted.
OPENBOARD_AGENT_WORKSPACE_ROOTS=

# Claude defaults to `default`; `plan` is also safe. `acceptEdits` is honored
# only in auth-off local mode, and `bypassPermissions` is always rejected.
OPENBOARD_CLAUDE_PERMISSION_MODE=default

# Publicly reachable HTTPS address of this deployment. Required for three
# things, all of which fail closed while it is unset: Seedance/Ark reference
# media (the provider fetches the URL from its own network), the OAuth
# redirect below, and the short-lived media reference tokens. A loopback or
# plain-HTTP value is rejected because a third party cannot resolve it.
OPENBOARD_PUBLIC_BASE_URL=

# Optional Linux.do OAuth sign-in. Both values are required to enable it; the
# redirect defaults to OPENBOARD_PUBLIC_BASE_URL + /api/auth/oauth/linuxdo/callback
# and only needs setting when the provider is registered against another URL.
OPENBOARD_LINUXDO_CLIENT_ID=
OPENBOARD_LINUXDO_CLIENT_SECRET=
OPENBOARD_LINUXDO_REDIRECT_URL=

# Required bearer token. The bundled reverse proxy injects it into API requests,
# so it is not exposed to browser JavaScript. Generate a long random value and
# keep the .env file out of version control.
OPENBOARD_TOKEN=

# Required local infrastructure credentials. Use URL-safe hexadecimal values,
# for example `openssl rand -hex 32`; services stay on the private Compose network.
OPENBOARD_POSTGRES_PASSWORD=
OPENBOARD_REDIS_PASSWORD=

# Local direct-service URLs. In Compose, these are assembled automatically from
# the credentials above and the private service names.
OPENBOARD_DATABASE_URL=postgres://openboard_local:<password>@127.0.0.1:5432/openboard_local?sslmode=disable
OPENBOARD_REDIS_URL=redis://127.0.0.1:6379/15

# 32-byte AES key encoded as 64 hexadecimal characters. Changing it makes saved
# provider credentials unreadable; back it up with the database.
OPENBOARD_MASTER_KEY=

# Optional S3-compatible protected media backend (AWS S3, Cloudflare R2,
# MinIO). Leave OPENBOARD_BLOB_BACKEND=filesystem to keep the /data volume.
# API clients still use /api/blobs/*; credentials never enter the browser.
OPENBOARD_BLOB_BACKEND=filesystem
OPENBOARD_S3_ENDPOINT=
OPENBOARD_S3_BUCKET=
OPENBOARD_S3_REGION=auto
OPENBOARD_S3_PREFIX=openboard
OPENBOARD_S3_ACCESS_KEY_ID=
OPENBOARD_S3_SECRET_ACCESS_KEY=
OPENBOARD_S3_SESSION_TOKEN=
# Permit plain HTTP only for a loopback MinIO endpoint.
OPENBOARD_S3_ALLOW_INSECURE_LOOPBACK=false

# Optional verbose server diagnostics. Debug files are permission-restricted;
# leave disabled for normal production operation.
OPENBOARD_DEBUG=false

# Provider requests are direct by default. Set this only when the deployment
# explicitly needs an HTTP(S) or SOCKS proxy for external model services.
OPENBOARD_PROVIDER_PROXY_URL=
